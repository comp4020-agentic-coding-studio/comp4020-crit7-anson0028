        "iso_date": {
          "name": "iso_date",
          "value": "\"bookings\".\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'"
        },
        "ends_after_start": {
          "name": "ends_after_start",
          "value": "\"bookings\".\"end_min\" > \"bookings\".\"start_min\""
        },
        "within_a_day": {
          "name": "within_a_day",
          "value": "\"bookings\".\"start_min\" >= 0 AND \"bookings\".\"end_min\" <= 1440"
        },
        "half_hour_slots": {
          "name": "half_hour_slots",
          "value": "\"bookings\".\"start_min\" % 30 = 0 AND \"bookings\".\"end_min\" % 30 = 0"
        },
        "at_most_two_hours": {
          "name": "at_most_two_hours",
          "value": "\"bookings\".\"end_min\" - \"bookings\".\"start_min\" <= 120"
        },
        "anu_email": {
          "name": "anu_email",
          "value": "lower(\"bookings\".\"email\") LIKE '%@anu.edu.au'"
        },
        "party_positive": {
          "name": "party_positive",
          "value": "\"bookings\".\"party_size\" >= 1"
